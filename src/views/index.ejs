
<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="list-section">
    <div class="list-container">

        <nav class="breadcrumb" aria-label="Ruta de navegación">
            <a href="/">Inicio</a>
            <span>/</span>
            <span>Productos</span>
        </nav>

        <div class="list-toolbar">
            <div>
                <span class="sub-label">CATÁLOGO</span>
                <h1>Productos</h1>
                <p class="list-count">
                    <%= products.length %>
                    <%= products.length === 1 ? 'producto' : 'productos' %>
                    <%= search ? 'encontrados' : 'disponibles' %>
                </p>
            </div>

            <% if (user && user.category === 'admin') { %>
                <a href="/products/create" class="btn btn-primary">
                    + Nuevo producto
                </a>
            <% } %>
        </div>

        <!-- BUSCADOR DE PRODUCTOS -->
        <form action="/products" method="GET" class="product-search">
            <input
                type="search"
                name="search"
                placeholder="Buscar granizados, frutas o toppings..."
                value="<%= search || '' %>"
                aria-label="Buscar productos"
                class="search-input"
            >

            <button type="submit" class="btn btn-primary">
                🔍 Buscar
            </button>

            <% if (search) { %>
                <a href="/products" class="btn btn-outline">
                    Limpiar
                </a>
            <% } %>
        </form>

        <!-- LISTADO DE PRODUCTOS -->
        <% if (products.length === 0) { %>
            <div class="cart-empty">

                <% if (search) { %>
                    <p>
                        No encontramos productos que coincidan con
                        "<%= search %>". 🍧
                    </p>

                    <a href="/products" class="btn btn-outline">
                        Ver todos los productos
                    </a>
                <% } else { %>
                    <p>Todavía no hay productos 🍧</p>

                    <% if (user && user.category === 'admin') { %>
                        <a href="/products/create" class="btn btn-primary">
                            Crear el primero
                        </a>
                    <% } %>
                <% } %>

            </div>
        <% } else { %>

            <div class="products-grid">

                <% products.forEach(product => { %>

                    <article class="product-card">

                        <div class="product-img-wrapper">
                            <span class="tag tag-<%= tagColor(product.category) %>">
                                <%= product.category %>
                            </span>

                            <a href="/products/<%= product.id %>">
                                <img
                                    src="<%= product.image %>"
                                    alt="<%= product.name %>"
                                >
                            </a>
                        </div>

                        <div class="product-info">

                            <div class="product-title-price">
                                <h3>
                                    <a href="/products/<%= product.id %>">
                                        <%= product.name %>
                                    </a>
                                </h3>

                                <span class="price">
                                    <%= formatPrice(product.price) %>
                                </span>
                            </div>

                            <p><%= product.description %></p>

                            <div class="card-actions">

                                <a
                                    href="/products/<%= product.id %>"
                                    class="btn btn-outline"
                                >
                                    Ver detalle
                                </a>

                                <% if (user && user.category === 'admin') { %>

                                    <a
                                        href="/products/<%= product.id %>/edit"
                                        class="btn btn-secondary"
                                    >
                                        Editar
                                    </a>

                                    <form
                                        action="/products/<%= product.id %>?_method=DELETE"
                                        method="POST"
                                        onsubmit="return confirm('¿Seguro que quieres eliminar este producto?')"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-danger"
                                        >
                                            Eliminar
                                        </button>
                                    </form>

                                <% } %>

                            </div>
                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </div>
</main>

<%- include('partials/footer') %>
