
<%- include('../../partials/head') %>
<%- include('../../partials/header') %>

<main class="detail-section">
  <div class="detail-container">

    <nav class="breadcrumb">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/admin/users">Administrar usuarios</a>
      <span>/</span>
      <span><%= buttonText %></span>
    </nav>

    <div class="section-header">
      <span class="sub-label">PANEL ADMINISTRATIVO</span>
      <h1><%= buttonText %></h1>
    </div>

    <div style="max-width: 650px; margin: 30px auto;">

      <% if (Object.keys(errors).length > 0) { %>
        <div class="form-alert" role="alert">
          Revisa los campos marcados en rojo antes de continuar.
        </div>
      <% } %>

      <form
        action="<%= action %>"
        method="POST"
        class="auth-form"
        novalidate
        data-validate
      >

        <div class="form-group <%= errors.firstName ? 'has-error' : '' %>">
          <label for="firstName">Nombre</label>
          <input
            type="text"
            id="firstName"
            name="firstName"
            value="<%= formUser?.firstName || '' %>"
            data-label="El nombre"
            data-rules="required|min:2|max:100"
            aria-invalid="<%= errors.firstName ? 'true' : 'false' %>"
          >
          <% if (errors.firstName) { %>
            <p class="form-error"><%= errors.firstName %></p>
          <% } %>
        </div>

        <div class="form-group <%= errors.lastName ? 'has-error' : '' %>">
          <label for="lastName">Apellido</label>
          <input
            type="text"
            id="lastName"
            name="lastName"
            value="<%= formUser?.lastName || '' %>"
            data-label="El apellido"
            data-rules="required|min:2|max:100"
            aria-invalid="<%= errors.lastName ? 'true' : 'false' %>"
          >
          <% if (errors.lastName) { %>
            <p class="form-error"><%= errors.lastName %></p>
          <% } %>
        </div>

        <div class="form-group <%= errors.email ? 'has-error' : '' %>">
          <label for="email">Correo electrónico</label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= formUser?.email || '' %>"
            data-label="El correo"
            data-rules="required|email|max:255"
            aria-invalid="<%= errors.email ? 'true' : 'false' %>"
          >
          <% if (errors.email) { %>
            <p class="form-error"><%= errors.email %></p>
          <% } %>
        </div>

        <% if (!formUser?.id) { %>
          <div class="form-group <%= errors.password ? 'has-error' : '' %>">
            <label for="password">Contraseña</label>
            <input
              type="password"
              id="password"
              name="password"
              autocomplete="new-password"
              data-label="La contraseña"
              data-rules="required|min:8|strong"
              aria-invalid="<%= errors.password ? 'true' : 'false' %>"
            >
            <p class="form-hint">Mínimo 8 caracteres, con mayúsculas, minúsculas, un número y un carácter especial.</p>
            <% if (errors.password) { %>
              <p class="form-error"><%= errors.password %></p>
            <% } %>
          </div>
        <% } %>

        <div class="form-group <%= errors.category ? 'has-error' : '' %>">
          <label for="category">Rol del usuario</label>
          <select
            id="category"
            name="category"
            data-label="El rol"
            data-rules="required"
            aria-invalid="<%= errors.category ? 'true' : 'false' %>"
          >
            <option value="customer"
              <%= (!formUser || formUser.category === 'customer') ? 'selected' : '' %>>
              Cliente
            </option>

            <option value="admin"
              <%= formUser?.category === 'admin' ? 'selected' : '' %>>
              Administrador
            </option>
          </select>

          <% if (errors.category) { %>
            <p class="form-error"><%= errors.category %></p>
          <% } %>
        </div>

        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
          <button type="submit" class="btn btn-primary">
            <%= buttonText %>
          </button>

          <a href="/admin/users" class="btn btn-outline">
            Cancelar
          </a>
        </div>

      </form>
    </div>

  </div>
</main>

<%- include('../../partials/footer') %>
