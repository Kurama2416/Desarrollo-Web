
<%- include('../../partials/head') %>
<%- include('../../partials/header') %>

<main class="detail-section">
  <div class="detail-container">

    <nav class="breadcrumb">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/admin/users">Administrar usuarios</a>
      <span>/</span>
      <span><%= buttonText %></span>
    </nav>

    <div class="section-header">
      <span class="sub-label">PANEL ADMINISTRATIVO</span>
      <h1><%= buttonText %></h1>
    </div>

    <form
      action="<%= action %>"
      method="POST"
      style="max-width: 650px; margin: 30px auto;"
    >

      <div style="margin-bottom: 20px;">
        <label for="firstName">Nombre</label>
        <input
          type="text"
          id="firstName"
          name="firstName"
          value="<%= user?.firstName || '' %>"
          required
          minlength="2"
          style="width: 100%; padding: 12px;"
        >
        <% if (errors.firstName) { %>
          <p style="color: #c62828;"><%= errors.firstName %></p>
        <% } %>
      </div>

      <div style="margin-bottom: 20px;">
        <label for="lastName">Apellido</label>
        <input
          type="text"
          id="lastName"
          name="lastName"
          value="<%= user?.lastName || '' %>"
          required
          minlength="2"
          style="width: 100%; padding: 12px;"
        >
        <% if (errors.lastName) { %>
          <p style="color: #c62828;"><%= errors.lastName %></p>
        <% } %>
      </div>

      <div style="margin-bottom: 20px;">
        <label for="email">Correo electrónico</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= user?.email || '' %>"
          required
          style="width: 100%; padding: 12px;"
        >
        <% if (errors.email) { %>
          <p style="color: #c62828;"><%= errors.email %></p>
        <% } %>
      </div>

      <% if (!user?.id) { %>
        <div style="margin-bottom: 20px;">
          <label for="password">Contraseña</label>
          <input
            type="password"
            id="password"
            name="password"
            minlength="8"
            required
            style="width: 100%; padding: 12px;"
          >
          <% if (errors.password) { %>
            <p style="color: #c62828;"><%= errors.password %></p>
          <% } %>
        </div>
      <% } %>

      <div style="margin-bottom: 25px;">
        <label for="category">Rol del usuario</label>
        <select
          id="category"
          name="category"
          required
          style="width: 100%; padding: 12px;"
        >
          <option value="customer"
            <%= (!user || user.category === 'customer') ? 'selected' : '' %>>
            Cliente
          </option>

          <option value="admin"
            <%= user?.category === 'admin' ? 'selected' : '' %>>
            Administrador
          </option>
        </select>

        <% if (errors.category) { %>
          <p style="color: #c62828;"><%= errors.category %></p>
        <% } %>
      </div>

      <div style="display: flex; gap: 15px; flex-wrap: wrap;">
        <button type="submit" class="btn btn-primary">
          <%= buttonText %>
        </button>

        <a href="/admin/users" class="btn btn-outline">
          Cancelar
        </a>
      </div>

    </form>

  </div>
</main>

<%- include('../../partials/footer') %>
