<footer class="footer">

    <div class="footer-content">

        <div class="footer-logo">
            <%= data.empresa.nombre %>
        </div>

        <div class="footer-links">

            <% data.navegacion.forEach(item => { %>

                <a href="<%= item.link %>">
                    <%= item.label %>
                </a>

            <% }); %>

        </div>

        <p>
            <%= data.empresa.copyright %>
        </p>

    </div>

</footer>