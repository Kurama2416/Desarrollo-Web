<%- include('partials/head') %>
<%- include('partials/header') %>

    <main class="auth-section">
        <div class="auth-card">

            <div class="auth-header">
                <span class="sub-label">BIENVENIDO DE NUEVO</span>
                <h1>Iniciar sesión</h1>
                <p>Ingresa para ver tu historial de compras.</p>
            </div>

            <% if (errors.general) { %>
                <div class="form-alert" role="alert">
                    <%= errors.general %>
                </div>
            <% } %>

            <form action="/login" method="POST" class="auth-form" novalidate>

                <div class="form-group <%= errors.general ? 'has-error' : '' %>">
                    <label for="correo">Correo electrónico</label>
                    <input type="email" id="correo" name="correo"
                           value="<%= old.correo || '' %>"
                           placeholder="nombre@correo.com" autocomplete="email"
                           aria-invalid="<%= errors.general ? 'true' : 'false' %>">
                </div>

                <div class="form-group <%= errors.general ? 'has-error' : '' %>">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password"
                           placeholder="Tu contraseña" autocomplete="current-password"
                           aria-invalid="<%= errors.general ? 'true' : 'false' %>">
                </div>

                <div class="form-group form-check">
                    <label for="recordarme">
                        <input type="checkbox" id="recordarme" name="recordarme" value="si">
                        Recordarme en este dispositivo
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">Iniciar sesión</button>
            </form>

            <details class="auth-recover">
                <summary>¿Olvidaste tu contraseña?</summary>
                <div class="form-group">
                    <label for="correo-recuperar">Correo con el que te registraste</label>
                    <input type="email" id="correo-recuperar" placeholder="nombre@correo.com" autocomplete="email">
                </div>
                <button type="button" class="btn btn-secondary">Enviar enlace de recuperación</button>
            </details>

            <p class="auth-alt">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>

        </div>
    </main>

<%- include('partials/footer') %>