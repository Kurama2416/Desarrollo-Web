<%- include('../partials/head') %>
<%- include('../partials/header') %>

    <main class="list-section">
        <div class="list-container">

            <nav class="breadcrumb" aria-label="Ruta de navegación">
                <a href="/">Inicio</a>
                <span>/</span>
                <span>Productos</span>
            </nav>

            <div class="list-toolbar">
                <div>
                    <span class="sub-label">CATÁLOGO</span>
                    <h1>Productos</h1>
                    <p class="list-count"><%= productos.length %> <%= productos.length === 1 ? 'producto' : 'productos' %> disponibles</p>
                </div>
                <a href="/productos/crear" class="btn btn-primary">+ Nuevo producto</a>
            </div>

            <% if (productos.length === 0) { %>
                <div class="cart-empty">
                    <p>Todavía no hay productos 🍧</p>
                    <a href="/productos/crear" class="btn btn-primary">Crear el primero</a>
                </div>
            <% } else { %>
                <div class="products-grid">
                    <% productos.forEach(prod => { %>
                        <article class="product-card">
                            <div class="product-img-wrapper">
                                <span class="tag tag-<%= prod.tagColor %>"><%= prod.tag %></span>
                                <a href="/producto/<%= prod.id %>">
                                    <img src="<%= prod.imagen %>" alt="<%= prod.nombre %>">
                                </a>
                            </div>
                            <div class="product-info">
                                <div class="product-title-price">
                                    <h3><a href="/producto/<%= prod.id %>"><%= prod.nombre %></a></h3>
                                    <span class="price"><%= formatPrice(prod.precio) %></span>
                                </div>
                                <p><%= prod.descripcion %></p>
                                <div class="card-actions">
                                    <a href="/producto/<%= prod.id %>" class="btn btn-outline">Ver detalle</a>
                                    <a href="/productos/<%= prod.id %>/editar" class="btn btn-secondary">Editar</a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>

        </div>
    </main>

<%- include('../partials/footer') %>