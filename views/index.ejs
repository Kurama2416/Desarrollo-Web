<%- include('partials/head') %>
<%- include('partials/header') %>

    <section id="inicio" class="hero">
        <div class="hero-container" id="heroContainer">
            <div class="hero-left">
                <span class="hero-badge"><%= data.hero.badge %></span>
                <h1 class="hero-title">
                    <span class="italic"><%= data.hero.tituloItalic %></span> <span class="bold"><%= data.hero.tituloBold %></span>
                </h1>
                <p class="hero-description"><%= data.hero.descripcion %></p>
                <div class="hero-actions">
                    <a href="<%= wppLink %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-wpp"><%= data.hero.btnPrincipal %></a>
                    <a href="#menu" class="btn btn-secondary"><%= data.hero.btnSecundario %></a>
                </div>
                <div class="hero-features">
                    <% data.hero.caracteristicas.forEach(f => { %>
                        <span><%= f %></span>
                    <% }) %>
                </div>
            </div>
            <div class="hero-right">
                <div class="hero-card">
                    <img src="<%= data.hero.cardDestacada.imagen %>" alt="<%= data.hero.cardDestacada.titulo %>">
                    <div class="card-floating-price">
                        <h3><%= data.hero.cardDestacada.titulo %></h3>
                        <p><%= formatPrice(data.hero.cardDestacada.precio) %></p>
                    </div>
                    <div class="card-badge-rating">
                        <div class="stars"><%= data.hero.cardDestacada.rating %></div>
                        <small><%= data.hero.cardDestacada.pedidos %></small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="menu" class="menu-section">
        <div class="section-header" id="menuHeader">
            <span class="sub-label"><%= data.seccionMenu.subtitulo %></span>
            <h2><%= data.seccionMenu.titulo %></h2>
            <p><%= data.seccionMenu.descripcion %></p>
        </div>
        <div class="products-grid" id="productsGrid">
            <% data.productos.forEach(prod => { %>
                <article class="product-card">
                    <div class="product-img-wrapper">
                        <span class="tag tag-<%= prod.tagColor %>"><%= prod.tag %></span>
                        <a href="/producto/<%= prod.id %>">
                            <img src="<%= prod.imagen %>" alt="<%= prod.nombre %>">
                        </a>
                    </div>
                    <div class="product-info">
                        <div class="product-title-price">
                            <h3><a href="/producto/<%= prod.id %>"><%= prod.nombre %></a></h3>
                            <span class="price"><%= formatPrice(prod.precio) %></span>
                        </div>
                        <p><%= prod.descripcion %></p>
                        <a href="<%= wppLink %>?text=Hola!%20Quiero%20pedir%20un%20<%= encodeURIComponent(prod.nombre) %>"
                           target="_blank" rel="noopener noreferrer" class="btn btn-outline">Pedir este 🍧</a>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>

    <section id="nosotros" class="about-section">
        <div class="about-container" id="aboutContainer">
            <div class="about-left">
                <img src="<%= data.historia.imagenHistoria %>" alt="Historia Manglü">
                <span class="about-card-badge"><%= data.historia.badgeCard %></span>
            </div>
            <div class="about-content">
                <span class="sub-label" style="color: var(--bg-yellow);"><%= data.historia.subtitulo %></span>
                <h2><%= data.historia.titulo %></h2>
                <p><%= data.historia.parrafo1 %></p>
                <p><%= data.historia.parrafo2 %></p>
                <div class="stats-grid">
                    <% data.historia.stats.forEach(s => { %>
                        <div class="stat-item">
                            <h3><%= s.cifra %></h3>
                            <p><%= s.label %></p>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </section>

    <section id="galeria" class="gallery-section">
        <div class="section-header" id="galleryHeader">
            <span class="sub-label"><%= data.galeria.subtitulo %></span>
            <h2><%= data.galeria.titulo %></h2>
            <p style="margin-top:0.5rem;">Síguenos en Instagram <span class="instagram-pill"><%= data.empresa.instagram %></span></p>
        </div>
        <div class="gallery-grid" id="galleryGrid">
            <% data.galeria.imagenes.forEach(img => { %>
                <div class="gallery-item">
                    <img src="<%= img %>" alt="Galería Manglü">
                </div>
            <% }) %>
        </div>
        <div class="gallery-footer" id="galleryFooter">
            <a href="https://instagram.com/<%= data.empresa.instagram.replace('@', '') %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary"><%= data.galeria.btnInstagram %></a>
        </div>
    </section>

    <section id="contacto" class="cta-whatsapp">
        <div class="cta-container" id="ctaContainer">
            <div class="emoji-header"><%= data.cta.emoji %></div>
            <h2><%= data.cta.titulo %></h2>
            <p><%= data.cta.descripcion1 %></p>
            <p><%= data.cta.descripcion2 %></p>
            <div style="margin-top: 1.5rem;">
                <a href="<%= wppLink %>" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
                    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                    <%= data.cta.btnTexto %>
                </a>
            </div>
            <div>
                <span class="phone-badge">📞 <%= data.empresa.telefonoFormateado %></span>
            </div>
        </div>
    </section>

<%- include('partials/footer') %>